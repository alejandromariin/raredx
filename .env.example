# Copy to .env and fill in. Never commit .env.
# LLM providers, used through Bifrost
OPENAI_API_KEY=          # GPT-6 Luna (extraction, diagnosis, summary) and embeddings
GEMINI_API_KEY=          # Gemini 3.5 Flash-Lite, Google AI Studio free tier
GROQ_API_KEY=            # gpt-oss-120b, Groq free tier (contamination check only)
# Live evidence (optional: without it the step is skipped)
TAVILY_API_KEY=
# PubMed publication dates for `make data` (optional, faster with a key)
NCBI_API_KEY=
NCBI_EMAIL=
# Where the app finds Bifrost (docker compose sets it to http://bifrost:8080 for the app container)
BIFROST_URL=http://localhost:8080
